Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1/Description Topic1
        - /LaserScan1/Status1
        - /RGB-D camera1/Depth image1/Topic1
        - /RGB-D camera1/Depth point cloud1
      Splitter Ratio: 0.5
    Tree Height: 786
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
