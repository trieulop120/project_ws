<?xml version="1.0"?>
<!--
  AMR Gazebo Classic Configuration
  Sensors Sllidar A1M8, Astra RGB Camera
-->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- INCLUDE BASE URDF (from SolidWorks export)                   -->
  <!-- ============================================================ -->
  <xacro:include filename="$(find amr_description)/urdf/amr_description.urdf"/>

  <!-- ============================================================ -->
  <!-- BASE FOOTPRINT (root link for navigation - placed after include) -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <!-- PHYSICAL PROPERTIES -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- DRIVE WHEELS high friction -->
  <gazebo reference="front_encoder_wheel_left_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
  </gazebo>

  <gazebo reference="front_encoder_wheel_right_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
  </gazebo>

  <!-- CASTER JOINTS passive free rotation -->
  <gazebo reference="rear_caster_steer_left_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="rear_caster_steer_right_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="rear_caster_wheel_left_link">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
  </gazebo>

  <gazebo reference="rear_caster_wheel_right_link">
    <material>Gazebo/Black</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
  </gazebo>

  <!-- LIFT LINKS -->
  <gazebo reference="base_lift_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="encoder_lift_link">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="left_fork_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="right_fork_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- LIDAR black -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <!-- CAMERA black -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <!-- ============================================================ -->
  <!-- LIDAR SENSOR (Sllidar A1M8 simulation)                       -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="gazebo_ros_lidar">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
        <updateRate>10</updateRate>
        <min_range>0.4</min_range>
        <max_range>12.0</max_range>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- ASTRA PRO DEPTH CAMERA (RGB + Depth + PointCloud)           -->                       -->
  <!-- ============================================================ -->

  <!-- Optical Frame (REP 103 standard) -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="depth" name="astra_pro">
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>  <!-- 60 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <clip>
          <near>0.6</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>astra_pro/image_raw:=color/image_raw</remapping>
          <remapping>astra_pro/camera_info:=color/camera_info</remapping>
          <remapping>astra_pro/depth/image_raw:=depth/image_raw</remapping>
          <remapping>astra_pro/depth/camera_info:=depth/camera_info</remapping>
          <remapping>astra_pro/points:=points</remapping>
        </ros>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.6</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- DIFFERENTIAL DRIVE PLUGIN (for teleop_twist_keyboard)        -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/diff_drive/cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <!-- Drive wheels (front encoder wheels) -->
      <left_joint>front_encoder_wheel_left_joint</left_joint>
      <right_joint>front_encoder_wheel_right_joint</right_joint>

      <!-- Kinematics  -->
      <wheel_separation>0.4722</wheel_separation>
      <wheel_diameter>0.068</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>0.863</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- Output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!-- JOINT STATE PUBLISHER (drive joints only, NOT lift) -->
  <!-- Lift joint is managed by ros2_control -->
  <!-- FIX Reduced update_rate to sync with sim time -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>  <!-- Reduced from 50 to match sim time --> 
      <!-- Drive wheels -->
      <joint_name>front_encoder_wheel_left_joint</joint_name>
      <joint_name>front_encoder_wheel_right_joint</joint_name>
      <!-- Caster joints -->
      <joint_name>rear_caster_steer_left_joint</joint_name>
      <joint_name>rear_caster_steer_right_joint</joint_name>
      <joint_name>rear_caster_wheel_left_joint</joint_name>
      <joint_name>rear_caster_wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ros2_control  -->
  <ros2_control name="amr_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="encoder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find amr_description)/config/lift_controller.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
</robot>
