<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_hardware</name>
  <version>1.0.0</version>
  <description>AMR Hardware Bridge</description>
  <maintainer email="user@example.com">AMR Developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-pyserial</depend>

  <!-- Optional RF2O laser odometry integration (use_rf2o:=true) -->
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>amr_localization</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
