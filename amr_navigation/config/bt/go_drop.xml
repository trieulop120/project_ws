<?xml version="1.0"?>
<!--
  Mission: Go Drop
  Uses ComputePathToPose and FollowPath directly to Drop goal pose
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="go_drop">
      <ComputePathToPose goal="{goal}" path="{path}"/>
      <FollowPath path="{path}"/>
    </Sequence>
  </BehaviorTree>
</root>