<?xml version="1.0"?>
<!--
  Mission: PICK → DROP
  start_id = 1 (PICK)
  goal_id  = 2 (DROP)
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="pick_to_drop">

      <!-- Set fixed route IDs -->
      <SetBlackboard value="1" output_key="my_start_id"/>
      <SetBlackboard value="2" output_key="my_goal_id"/>

      <!-- Phase 1: Compute route on route graph -->
      <ComputeRoute
        start_id="{my_start_id}"
        goal_id="{my_goal_id}"
        use_start="false"
        use_poses="false"
        path="{path}"
        route="{route}"/>

      <!-- Phase 2: Follow route to endpoint -->
      <FollowPath
        path="{path}"/>

      <!-- Phase 3: Compute path to exact PoseStamped goal -->
      <ComputePathToPose
        goal="{goal}"
        path="{path}"/>

      <!-- Phase 4: Follow last-mile path -->
      <FollowPath
        path="{path}"/>

    </Sequence>
  </BehaviorTree>
</root>
