<?xml version="1.0"?>
<!--
  Mission: Go Pick 2
  Uses ComputePathToPose and FollowPath directly to Pick 2 goal pose
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="go_pick_2">
      <ComputePathToPose goal="{goal}" path="{path}"/>
      <FollowPath path="{path}"/>
    </Sequence>
  </BehaviorTree>
</root>