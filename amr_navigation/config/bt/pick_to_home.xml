<?xml version="1.0"?>
<!--
  Mission: PICK → HOME
  start_id = 1 (P_1)
  goal_id  = 0 (HOME)
  Route: 1 → 5 → 6 → 2 → 7 → 4 → 3 → 0
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="pick_to_home">

      <!-- Set fixed route IDs -->
      <SetBlackboard value="1" output_key="my_start_id"/>
      <SetBlackboard value="0" output_key="my_goal_id"/>

      <!-- Phase 1: Compute route on route graph -->
      <ComputeRoute
        start_id="{my_start_id}"
        goal_id="{my_goal_id}"
        use_start="false"
        use_poses="false"
        path="{path}"
        route="{route}"/>

      <!-- Phase 2: Follow route to endpoint -->
      <FollowPath
        path="{path}"/>

      <!-- Phase 3: Compute path to exact PoseStamped goal -->
      <ComputePathToPose
        goal="{goal}"
        path="{path}"/>

      <!-- Phase 4: Follow last-mile path -->
      <FollowPath
        path="{path}"/>

    </Sequence>
  </BehaviorTree>
</root>
