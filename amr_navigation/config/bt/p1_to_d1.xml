<?xml version="1.0"?>
<!--
  Mission: P_1 → D_1
  start_id = 1 (P_1)
  goal_id  = 3 (D_1)

  Hybrid navigation (Route → Free):
    1. Nhanh: ComputeRoute + FollowPath  (di theo route graph, tuan thu luong giao thong)
    2. Fallback: ComputePathToPose + FollowPath  (Nav2 tu tim duong bang costmap)
       -> BT Fallback tu dong nhay sang nhanh 2 khi route_server loi
          (graph malformed / thieu edge / 2 diem khong noi duoc).

  QUAN TRONG: tach 2 blackboard key rieng ({route_path} va {free_path}).
  Khong dung chung {path} cho ca 2 nhanh - tranh xung dot bo nho controller.

  ID phai khop thu tu node trong 'D203B Route.yaml':
    0=NODE_HOME 1=P_1 2=P_2 3=D_1
  (mission_manager_node.py kiem tra (start_id, goal_id) truoc khi gui goal.)
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="hybrid_nav">
      <!-- CHINH: uu tien di theo route -->
      <Sequence name="route_nav">
        <SetBlackboard value="1" output_key="my_start_id"/>
        <SetBlackboard value="3" output_key="my_goal_id"/>

        <ComputeRoute
          start_id="{my_start_id}"
          goal_id="{my_goal_id}"
          use_start="false"
          use_poses="false"
          path="{route_path}"
          route="{route}"/>

        <FollowPath path="{route_path}"/>

        <!-- Chot pose dich chinh xac sau khi da di het route graph -->
        <ComputePathToPose goal="{goal}" path="{goal_pose_path}"/>
        <FollowPath path="{goal_pose_path}"/>
      </Sequence>

      <!-- FALLBACK: route_server loi -> Nav2 free navigation -->
      <Sequence name="free_nav">
        <ComputePathToPose goal="{goal}" path="{free_path}"/>
        <FollowPath path="{free_path}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
